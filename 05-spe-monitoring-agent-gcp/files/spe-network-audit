#!/usr/bin/env bash

set -euo pipefail

# GCP gives the VM one default route. Its interface is the one Zeek watches.
interface="$(ip -4 route show default | awk 'NR == 1 { print $5; exit }')"

if [[ -z "${interface}" ]]; then
  echo "No default network interface was found." >&2
  exit 1
fi

echo "Watching network interface ${interface}"
# GCP can calculate outgoing packet checksums after capture. -C prevents those
# pre-offload packets from being discarded as if their checksums were invalid.
exec /opt/zeek/bin/zeek -C -b -i "${interface}" /etc/zeek/spe-network-audit.zeek
