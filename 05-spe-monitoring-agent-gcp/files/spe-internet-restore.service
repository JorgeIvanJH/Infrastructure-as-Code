[Unit]
Description=Restore the saved SPE outbound internet mode
Documentation=file:/usr/local/sbin/spe-internet
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/spe-internet restore
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
