table inet spe_egress {
    chain output {
        type filter hook output priority filter; policy drop;

        # Local applications can still communicate with each other.
        oifname "lo" counter accept

        # Replies for inbound SSH and RDP, and traffic from connections that
        # were already open, continue to work.
        ct state established,related counter accept

        # Keep the cloud guest environment healthy. GCP, AWS, and Azure use
        # this link-local address for the VM metadata API (HTTP) and GCP also
        # serves time from it. Neither is a route to the general internet.
        # Which local users may use the API is decided in
        # /etc/spe-internet/metadata.nft, which applies in both modes.
        # DNS is deliberately not allowed: on GCP this address is also the
        # resolver, and a sealed SPE must not be able to resolve names.
        ip daddr 169.254.169.254 tcp dport 80 counter accept
        ip daddr 169.254.169.254 udp dport 123 counter accept

        # AWS serves time from a second link-local address. Accurate clocks
        # keep the audit timestamps trustworthy in either mode.
        ip daddr 169.254.169.123 udp dport 123 counter accept

        # Permit network address renewal after the mode survives a reboot.
        udp sport 68 udp dport 67 counter accept
        udp sport 546 udp dport 547 counter accept

        # Future control-layer exceptions are kept in a separate small file.
        include "/etc/spe-internet/allowlist.nft"
    }
}
